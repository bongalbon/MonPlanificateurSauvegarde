{
  "name": "backup-and-restaure-app",
  "version": "1.0.0",
  "description": "Système de Planification de Sauvegarde et Restauration",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "productName": "BackupAndRestaureApp",
    "appId": "com.backupandrestaure.app",
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    },
    "nsis": {
